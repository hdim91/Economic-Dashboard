# API Dashboard Project — 환경변수 템플릿
# 실제 값은 .env 파일에 작성 (절대 커밋하지 않음)
# GCP Secret Manager에 등록된 키와 동일

# ── GCP ──────────────────────────────────────────────────────────────────────
GCP_PROJECT_ID=auto-report-489722
GCS_BUCKET=gs://auto-report-489722-reports
BQ_DATASET=kosis_stats
BQ_FINANCE_DATASET=finance_stats

# ── 고용동향 API ──────────────────────────────────────────────────────────────
KOSIS_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
BLS_API_KEY=

# ── 금융동향 API ──────────────────────────────────────────────────────────────
ECOS_API_KEY=
FRED_API_KEY=

# ── 알림 ──────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── 파이프라인 설정 ───────────────────────────────────────────────────────────
ANALYSIS_ENABLED=false
REPORT_ENABLED=false
REPORT_FORMAT=html
REPORT_OUT_DIR=/app/report/output
REPORT_UPLOAD_GCS=true
